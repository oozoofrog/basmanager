{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "files": [
    { "kind": "folder", "path": "SmartBattery", "target-membership": [ "SmartBattery" ] },
    { "kind": "folder", "path": "SmartBatteryTests", "target-membership": [ "SmartBatteryTests" ] },
    { "kind": "folder", "path": "SmartBatteryUITests", "target-membership": [ "SmartBatteryUITests" ] },
    {
      "kind": "folder",
      "path": "SmartBatteryLiveActivity",
      "target-membership": [
        "SmartBatteryLiveActivityExtension",
      ],
      "membership-exceptions": [
        {
          "target": "SmartBatteryLiveActivityExtension",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Frameworks",
      "children": [
        { "path": "/System/Library/Frameworks/WidgetKit.framework", "target-membership": [ "SmartBatteryLiveActivityExtension/frameworks" ] },
        { "path": "/System/Library/Frameworks/SwiftUI.framework", "target-membership": [ "SmartBatteryLiveActivityExtension/frameworks" ] },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/SmartBattery.app", "id": "748014DF30B4A20C002D24A0", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/SmartBatteryTests.xctest", "id": "748014EC30B4A20D002D24A0", "type": "wrapper.cfbundle", "index": false },
